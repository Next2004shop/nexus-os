# ============================================
# NEXUS SOVEREIGN SYSTEM — Environment Config
# ============================================

# Deployment Environment (Phase 12)
# Options: LOCAL_DEV | STAGING | PRODUCTION
ENV_MODE=LOCAL_DEV

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=nexus-dyron-777
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Secret Manager Secret IDs
BINANCE_API_KEY=BINANCE_API_KEY
BINANCE_SECRET=BINANCE_SECRET
MT5_LOGIN=MT5_LOGIN
MT5_PASSWORD=MT5_PASSWORD
MT5_SERVER=MT5_SERVER

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_VERBOSITY=NORMAL

# Vertex AI Configuration
VERTEX_AI_REGION=us-central1
VERTEX_AI_MODEL=claude-3-5-haiku@20241022

# Risk & Execution (Phase 12)
RISK_LEVEL=CONSERVATIVE
MAX_POSITION_SIZE=0.01
MAX_DAILY_TRADES=20
EXECUTION_ALLOWED=false
PAPER_TRADING=true

# Deployment Controls (Phase 12)
DEPLOYMENT_LOCK=false
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
RESOURCE_MONITORING_ENABLED=true
LOG_LEVEL=INFO
